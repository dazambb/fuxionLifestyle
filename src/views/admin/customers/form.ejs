<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title">
            <i class="fas fa-<%= customer ? 'edit' : 'user-plus' %> me-2"></i><%= customer ? 'Editar' : 'Nuevo' %> Cliente
        </h2>
        <p class="text-muted">Completa la información del cliente</p>
    </div>
    <a href="/admin/customers" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Volver
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-body">
                <form action="/admin/customers/<%= customer ? customer.id + '/update' : 'create' %>" method="POST">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nombre Completo <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" value="<%= customer ? customer.name : '' %>" required>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Teléfono</label>
                            <div class="input-group">
                                <span class="input-group-text">+593</span>
                                <input type="text" name="phone" class="form-control" placeholder="999999999" value="<%= customer && customer.phone ? customer.phone : '' %>">
                            </div>
                            <small class="text-muted">Formato: 999999999 (sin +593)</small>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="email" class="form-control" value="<%= customer && customer.email ? customer.email : '' %>">
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ciudad</label>
                            <input type="text" name="city" class="form-control" value="<%= customer && customer.city ? customer.city : '' %>">
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Dirección</label>
                        <textarea name="address" class="form-control" rows="2"><%= customer && customer.address ? customer.address : '' %></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Notas</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Preferencias, alergias, objetivos, etc."><%= customer && customer.notes ? customer.notes : '' %></textarea>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Guardar Cliente
                        </button>
                        <a href="/admin/customers" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <% if (customer) { %>
    <div class="col-lg-4">
        <!-- Historial de compras -->
        <div class="card card-custom mb-3">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="fas fa-shopping-bag me-2"></i>Historial de Compras
                </h5>
                
                <!-- Formulario rápido para agregar compra -->
                <div class="purchase-form mb-3">
                    <button class="btn btn-sm btn-success w-100" onclick="togglePurchaseForm()">
                        <i class="fas fa-plus me-2"></i>Registrar Compra
                    </button>
                    
                    <div id="purchaseForm" style="display: none;" class="mt-3 p-3 bg-light rounded">
                        <form onsubmit="addPurchase(event)">
                            <input type="hidden" id="customer_id" value="<%= customer.id %>">
                            
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Producto</label>
                                <input type="text" id="product_name" class="form-control form-control-sm" required>
                            </div>
                            
                            <div class="row">
                                <div class="col-6 mb-2">
                                    <label class="form-label small fw-bold">Cantidad</label>
                                    <input type="number" id="quantity" class="form-control form-control-sm" value="1" min="1">
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="form-label small fw-bold">Monto $</label>
                                    <input type="number" id="amount" class="form-control form-control-sm" step="0.01">
                                </div>
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Fecha</label>
                                <input type="date" id="purchase_date" class="form-control form-control-sm" value="<%= new Date().toISOString().split('T')[0] %>" required>
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Notas</label>
                                <textarea id="purchase_notes" class="form-control form-control-sm" rows="2"></textarea>
                            </div>
                            
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                                    <i class="fas fa-save me-1"></i>Guardar
                                </button>
                                <button type="button" class="btn btn-secondary btn-sm" onclick="togglePurchaseForm()">
                                    Cancelar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                
                <!-- Lista de compras -->
                <div class="purchases-list">
                    <% if (purchases && purchases.length > 0) { %>
                        <% purchases.forEach(purchase => { %>
                            <div class="purchase-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong><%= purchase.product_name %></strong>
                                        <br>
                                        <small class="text-muted">
                                            <%= new Date(purchase.purchase_date).toLocaleDateString('es-ES') %>
                                        </small>
                                        <% if (purchase.quantity > 1) { %>
                                            <br><small>Cantidad: <%= purchase.quantity %></small>
                                        <% } %>
                                    </div>
                                    <% if (purchase.amount) { %>
                                        <span class="badge bg-success">$<%= parseFloat(purchase.amount).toFixed(2) %></span>
                                    <% } %>
                                </div>
                                <% if (purchase.notes) { %>
                                    <small class="text-muted d-block mt-1"><%= purchase.notes %></small>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-muted text-center small">No hay compras registradas</p>
                    <% } %>
                </div>
            </div>
        </div>
        
        <!-- Acciones rápidas -->
        <div class="card card-custom">
            <div class="card-body">
                <h6 class="card-title mb-3">
                    <i class="fas fa-bolt me-2"></i>Acciones Rápidas
                </h6>
                
                <% if (customer.phone) { %>
                    <a href="https://wa.me/593<%= customer.phone.replace(/\D/g, '') %>?text=Hola <%= customer.name %>, ¿cómo estás?" 
                       target="_blank" 
                       class="btn btn-success btn-sm w-100 mb-2">
                        <i class="fab fa-whatsapp me-2"></i>Enviar WhatsApp
                    </a>
                <% } %>
                
                <% if (customer.email) { %>
                    <a href="mailto:<%= customer.email %>" class="btn btn-info btn-sm w-100 mb-2">
                        <i class="fas fa-envelope me-2"></i>Enviar Email
                    </a>
                <% } %>
                
                <button onclick="deleteCustomer(<%= customer.id %>)" class="btn btn-danger btn-sm w-100">
                    <i class="fas fa-trash me-2"></i>Eliminar Cliente
                </button>
            </div>
        </div>
    </div>
    <% } %>
</div>

<style>
.page-title {
    font-size: 2rem;
    font-weight: 700;
    color: #2c3e50;
    margin-bottom: 0.5rem;
}

.purchase-item {
    padding: 0.75rem;
    background: #f8f9fa;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    border-left: 3px solid #4A7C59;
}

.purchases-list {
    max-height: 400px;
    overflow-y: auto;
}
</style>

<script>
function togglePurchaseForm() {
    const form = document.getElementById('purchaseForm');
    form.style.display = form.style.display === 'none' ? 'block' : 'none';
}

function addPurchase(event) {
    event.preventDefault();
    
    const data = {
        customer_id: document.getElementById('customer_id').value,
        product_name: document.getElementById('product_name').value,
        quantity: document.getElementById('quantity').value,
        amount: document.getElementById('amount').value,
        purchase_date: document.getElementById('purchase_date').value,
        notes: document.getElementById('purchase_notes').value
    };
    
    fetch('/admin/customers/purchase/add', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            location.reload();
        } else {
            alert('Error al agregar compra');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error al agregar compra');
    });
}

function deleteCustomer(id) {
    if (confirm('¿Estás segura que deseas eliminar este cliente? Esta acción eliminará también todas sus compras.')) {
        fetch(`/admin/customers/${id}/delete`, {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.href = '/admin/customers';
            } else {
                alert('Error al eliminar cliente');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error al eliminar cliente');
        });
    }
}
</script>
