<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Gestión del Blog</h4>
        <p class="text-muted small mb-0">
            <i class="fas fa-newspaper me-1"></i>
            <%= posts.length %> artículo(s) registrado(s)
        </p>
    </div>
    <a href="/admin/blog/new" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>
        Nuevo Artículo
    </a>
</div>

<div class="card-custom">
    <div class="card-body">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input 
                type="text" 
                id="searchPosts" 
                class="form-control" 
                placeholder="Buscar artículos por título, autor..." 
                onkeyup="searchTable('searchPosts', 'postsTable')">
        </div>
        
        <div class="table-responsive">
            <table class="table table-hover" id="postsTable">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Estado</th>
                        <th>Destacado</th>
                        <th>Vistas</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (posts.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No hay artículos registrados
                            </td>
                        </tr>
                    <% } else { %>
                        <% posts.forEach(post => { %>
                            <tr>
                                <td>
                                    <strong><%= post.title %></strong>
                                    <br>
                                    <small class="text-muted"><%= post.slug %></small>
                                </td>
                                <td><%= post.author %></td>
                                <td>
                                    <% if (post.published) { %>
                                        <span class="badge bg-success">Publicado</span>
                                    <% } else { %>
                                        <span class="badge bg-warning">Borrador</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (post.featured) { %>
                                        <i class="fas fa-star text-warning"></i>
                                    <% } else { %>
                                        <i class="far fa-star text-muted"></i>
                                    <% } %>
                                </td>
                                <td><%= post.views %></td>
                                <td>
                                    <small><%= new Date(post.created_at).toLocaleDateString('es-ES') %></small>
                                </td>
                                <td class="table-actions">
                                    <% if (post.published) { %>
                                        <a href="/blog/<%= post.id %>" target="_blank" 
                                           class="btn btn-sm btn-outline-info" 
                                           title="Ver artículo">
                                            <i class="fas fa-eye"></i> Ver
                                        </a>
                                    <% } %>
                                    <a href="/admin/blog/edit/<%= post.id %>" 
                                       class="btn btn-sm btn-outline-primary"
                                       title="Editar artículo">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <button onclick="confirmDelete('/admin/blog/delete/<%= post.id %>', 'artículo')" 
                                            class="btn btn-sm btn-outline-danger"
                                            title="Eliminar artículo">
                                        <i class="fas fa-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
