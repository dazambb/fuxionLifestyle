</head>
<body>
    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h4>
                <i class="fas fa-leaf"></i>
                FuXion Admin
            </h4>
        </div>
        
        <div class="sidebar-menu">
            <div class="menu-section-title">Principal</div>
            <a href="/admin/dashboard" class="menu-item <%= title && title.includes('Dashboard') ? 'active' : '' %>">
                <i class="fas fa-chart-line"></i>
                <span>Dashboard</span>
            </a>
            
            <div class="menu-section-title">Gestión</div>
            <a href="/admin/products" class="menu-item <%= title && title.includes('Productos') ? 'active' : '' %>">
                <i class="fas fa-box"></i>
                <span>Productos</span>
            </a>
            <a href="/admin/blog" class="menu-item <%= title && title.includes('Blog') ? 'active' : '' %>">
                <i class="fas fa-newspaper"></i>
                <span>Blog</span>
            </a>
            <a href="/admin/customers" class="menu-item <%= title && title.includes('Clientes') ? 'active' : '' %>">
                <i class="fas fa-users"></i>
                <span>Mis Clientes</span>
            </a>
            
            <div class="menu-section-title">Otros</div>
            <a href="/" target="_blank" class="menu-item">
                <i class="fas fa-globe"></i>
