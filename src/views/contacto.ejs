                            <small class="text-muted">Lun - Sáb: 9:00 AM - 8:00 PM</small>
                        </div>
                        <a href="tel:+593993161517" class="contact-info-action">
                            <i class="fas fa-phone-alt"></i>
                        </a>
                    </div>
                    
                    <div class="contact-info-card mb-3">
                        <div class="contact-info-icon bg-danger">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-info-content">
                            <h5 class="mb-1">Email</h5>
                            <p class="mb-1"><strong>contacto@fuxionlifestyle.com</strong></p>
                            <small class="text-muted">Respuesta en 24 horas</small>
                        </div>
                        <a href="mailto:contacto@fuxionlifestyle.com" class="contact-info-action">
                            <i class="fas fa-envelope-open"></i>
                        </a>
                    </div>
                    
                    <div class="contact-info-card mb-3 border-success">
                        <div class="contact-info-icon bg-success">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <div class="contact-info-content">
                            <h5 class="mb-1">WhatsApp</h5>
                            <p class="mb-1"><strong>+593 99 316 1517</strong></p>
                            <small class="text-muted">Respuesta inmediata</small>
                        </div>
                        <a href="https://wa.me/593993161517?text=Hola,%20necesito%20información" target="_blank" class="contact-info-action bg-success">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                    </div>
                    
                    <div class="contact-info-card mb-4">
                        <div class="contact-info-icon bg-warning">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-info-content">
                            <h5 class="mb-1">Ubicación</h5>
                            <p class="mb-1"><strong>Ecuador</strong></p>
                            <small class="text-muted">Envíos a todo el país</small>
                        </div>
                    </div>
                    
                    <div class="social-section mt-5">
                        <h5 class="mb-3"><i class="fas fa-share-alt me-2"></i>Síguenos</h5>
                        <div class="social-buttons-modern">
                            <a href="#" target="_blank" class="social-btn social-facebook">
