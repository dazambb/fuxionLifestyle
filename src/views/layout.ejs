<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Distribuidor Oficial de FuXion - Productos naturales para tu salud y bienestar. Descubre nuestros productos 100% naturales con envíos a todo el país.' %>">
    <meta name="keywords" content="FuXion, productos naturales, salud, bienestar, distribuidor oficial, nutrición, suplementos naturales, bioxtron, omniplus, hidratate plus">
    <meta name="author" content="FuXion Lifestyle">
    <meta name="robots" content="index, follow">
    <meta name="language" content="Spanish">
    <meta name="revisit-after" content="7 days">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://fuxionlifestyle.com<%= typeof currentUrl !== 'undefined' ? currentUrl : '/' %>">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/public/img/fuxion-icon.png">
    <link rel="shortcut icon" type="image/png" href="/public/img/fuxion-icon.png">
    <link rel="apple-touch-icon" href="/public/img/fuxion-icon.png">
    <link rel="manifest" href="/public/manifest.json">
    <meta name="theme-color" content="#4A7C59">
    
    <!-- Open Graph Meta Tags (Facebook, LinkedIn) -->
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'FuXion Lifestyle - Distribuidora Oficial' %>">
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Productos naturales de FuXion para tu salud y bienestar. Distribuidor oficial con envíos a todo el país.' %>">
    <meta property="og:image" content="https://fuxionlifestyle.com/public/img/og-image.jpg">
    <meta property="og:url" content="https://fuxionlifestyle.com<%= typeof currentUrl !== 'undefined' ? currentUrl : '/' %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="FuXion Lifestyle">
    <meta property="og:locale" content="es_ES">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'FuXion Lifestyle - Distribuidora Oficial' %>">
    <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Productos naturales de FuXion para tu salud y bienestar' %>">
    <meta name="twitter:image" content="https://fuxionlifestyle.com/public/img/og-image.jpg">
    <meta name="twitter:site" content="@fuxion">
    
    <title><%= typeof title !== 'undefined' ? title : 'FuXion Lifestyle - Distribuidora Oficial' %></title>
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/public/css/styles.css">
    
    <!-- Structured Data (Schema.org) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "FuXion Lifestyle",
        "url": "https://fuxionlifestyle.com",
        "logo": "https://fuxionlifestyle.com/public/img/logo.png",
        "description": "Distribuidor Oficial de FuXion - Productos naturales para tu salud y bienestar",
        "address": {
            "@type": "PostalAddress",
            "addressCountry": "EC"
        },
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+593-99-316-1517",
            "contactType": "customer service",
            "availableLanguage": "Spanish"
        },
        "sameAs": [
            "https://www.facebook.com/fuxion",
            "https://www.instagram.com/fuxion",
            "https://www.tiktok.com/@fuxion"
        ]
    }
    </script>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="/public/img/logo.png" alt="FuXion Lifestyle" srcset="" style="height: 3em;!important">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/productos">Productos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/blog">Blog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/distribuidor">Ser Distribuidor</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/contacto">Contacto</a>
                    </li>
                    <li class="nav-item ms-lg-3">
                        <a class="btn btn-primary" href="/productos">
                            <i class="fas fa-shopping-cart"></i> Comprar
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <%- body %>
    </main>

    <!-- Floating CTA Button -->
    <div class="floating-cta" style="box-shadow: none !important;">
        <a href="https://wa.me/593993161517?text=Hola%2C%20quisiera%20solicitar%20una%20asesoría%20gratuita%20sobre%20los%20productos%20FuXion" target="_blank" class="btn-cta">
            <i class="fas fa-headset"></i>
            <span>Asesoría Gratis</span>
        </a>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5><i class="fas fa-leaf"></i> FuXion Lifestyle</h5>
                    <p>
                        Distribuidora Oficial de FuXion. Productos naturales de la más alta calidad para tu salud y bienestar.
                    </p>
                    <div class="social-links">
                        <a href="#" target="_blank"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" target="_blank"><i class="fab fa-instagram"></i></a>
                        <a href="#" target="_blank"><i class="fab fa-whatsapp"></i></a>
                        <a href="#" target="_blank"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5>Enlaces</h5>
                    <ul>
                        <li><a href="/">Inicio</a></li>
                        <li><a href="/productos">Productos</a></li>
                        <li><a href="/blog">Blog</a></li>
                        <li><a href="/distribuidor">Ser Distribuidor</a></li>
                        <li><a href="/contacto">Contacto</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5>Productos</h5>
                    <ul>
                        <li><a href="/productos?categoria=energia">Energía</a></li>
                        <li><a href="/productos?categoria=defensas">Defensas</a></li>
                        <li><a href="/productos?categoria=peso">Control de Peso</a></li>
                        <li><a href="/productos?categoria=nutricion">Nutrición</a></li>
                        <li><a href="/productos?categoria=belleza">Belleza</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5>Contacto</h5>
                    <ul>
                        <li><i class="fas fa-phone"></i> +593 99 316 1517</li>
                        <li><i class="fas fa-envelope"></i> contacto@fuxionlifestyle.com</li>
                        <li><i class="fas fa-map-marker-alt"></i> Ecuador - España</li>
                    </ul>
                    <div class="mt-3">
                        <h6>Newsletter</h6>
                        <form id="newsletterForm" class="d-flex">
                            <input type="email" class="form-control me-2" placeholder="Tu email" required>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <p>&copy; 2025 FuXion Lifestyle. Todos los derechos reservados. | Distribuidora Independiente</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- AOS JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    
    <!-- Quiz Modal Pop-up -->
    <%- include('quiz-modal') %>
    
    <!-- Custom JS -->
    <script src="/public/js/main.js"></script>
</body>
</html>
