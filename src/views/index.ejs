<!-- Hero Section con Video -->
<section class="hero-section" style="position: relative; min-height: 100vh; display: flex; align-items: center; overflow: hidden;">
    <!-- Video de YouTube como fondo -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: hidden; z-index: 0;">
        <iframe 
            style="position: absolute; top: 50%; left: 50%; min-width: 100%; min-height: 100%; width: 100vw; height: 56.25vw; min-height: 100vh; min-width: 177.77vh; transform: translate(-50%, -50%);"
            src="https://www.youtube.com/embed/vBI1Ul1KDy0?autoplay=1&mute=1&loop=1&playlist=vBI1Ul1KDy0&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen>
        </iframe>
        <!-- Overlay oscuro para mejor legibilidad -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(74, 124, 89, 0.75) 0%, rgba(44, 85, 48, 0.65) 50%, rgba(26, 26, 26, 0.8) 100%); pointer-events: none;"></div>
    </div>
    
    <div class="container" style="position: relative; z-index: 10;">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center hero-content" data-aos="fade-up">
                <div class="badge bg-white text-dark mb-3 px-3 py-2" style="display: inline-block;">
                    <i class="fas fa-star text-warning"></i> #1 en Nutrición Natural
                </div>
                <h1 class="hero-title" style="font-size: 3.5rem;">Transforma tu Vida con <span style="color: #FFD700;">FuXion</span></h1>
                <p class="hero-subtitle" style="font-size: 1.3rem; max-width: 700px; margin: 0 auto;">
                    Descubre productos naturales respaldados por la ciencia que potencian tu energía, fortalecen tu salud y te ayudan a alcanzar tus metas de bienestar.
                </p>
                <div class="d-flex gap-3 flex-wrap justify-content-center mt-4" style="position: relative; z-index: 10;">
                    <a href="/productos" class="btn btn-light btn-lg px-5 py-3" style="position: relative; z-index: 10;">
                        <i class="fas fa-shopping-bag me-2"></i> Explorar Productos
                    </a>
                    <a href="/distribuidor" class="btn btn-outline-light btn-lg px-5 py-3" style="position: relative; z-index: 10;">
                        <i class="fas fa-handshake me-2"></i> Únete al Equipo
                    </a>
                </div>
                <div class="mt-5 d-flex gap-5 text-white justify-content-center">
                    <div>
                        <h3 class="mb-0 fw-bold">10K+</h3>
                        <small class="opacity-75">Clientes Felices</small>
                    </div>
                    <div class="border-start border-white border-opacity-25 ps-4">
                        <h3 class="mb-0 fw-bold">100%</h3>
                        <small class="opacity-75">Natural</small>
                    </div>
                    <div class="border-start border-white border-opacity-25 ps-4">
                        <h3 class="mb-0 fw-bold">15+</h3>
                        <small class="opacity-75">Años de Experiencia</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Indicador de scroll -->
    <div style="position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); z-index: 1; animation: bounce 2s infinite;">
        <i class="fas fa-chevron-down text-white fs-3 opacity-75"></i>
    </div>
</section>

<style>
@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
    40% { transform: translateX(-50%) translateY(-10px); }
    60% { transform: translateX(-50%) translateY(-5px); }
}
</style>

