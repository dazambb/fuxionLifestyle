<!-- Latest Blog Posts -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="section-title">Blog de Salud</h2>
            <p class="section-subtitle">Consejos y noticias sobre salud y bienestar</p>
        </div>
        
        <div class="row g-4">
            <% if (recentPosts && recentPosts.length > 0) { %>
                <% recentPosts.forEach((post, index) => { 
                    const postDate = new Date(post.created_at);
                    const formattedDate = postDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
                %>
                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="<%= (index + 1) * 100 %>">
                        <div class="card blog-card">
                            <img src="<%= post.image_url %>" class="card-img-top" alt="<%= post.title %>">
                            <div class="card-body">
                                <p class="blog-date"><i class="far fa-calendar"></i> <%= formattedDate %></p>
                                <h5 class="card-title"><%= post.title %></h5>
                                <p class="card-text"><%= post.excerpt %></p>
                                <a href="/blog/<%= post.slug %>" class="btn btn-outline-primary">Leer más</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No hay artículos disponibles. Publica contenido desde el panel administrativo.</p>
                </div>
            <% } %>
        </div>
        
        <div class="text-center mt-5" data-aos="fade-up">
            <a href="/blog" class="btn btn-outline-primary btn-lg">
                Ver Todos los Artículos <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>